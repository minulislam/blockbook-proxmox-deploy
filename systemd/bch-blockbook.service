[Unit]
Description=Blockbook Bitcoin Cash indexer and API
After=backend-bcash.service network.target
Wants=backend-bcash.service

[Service]
Type=simple
User=blockbook-bcash
Group=blockbook-bcash
ExecStart=/opt/coins/blockbook/bcash/bin/blockbook \
    -sync \
    -blockchaincfg=/opt/coins/blockbook/bcash/blockchaincfg.json \
    -internal=:9032 \
    -public=:9132 \
    -certfile=/opt/coins/blockbook/bcash/server/testcert \
    -dbcache=500 \
    -workers=4 \
    -logtostderr
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=30
TimeoutStartSec=600

LimitNOFILE=65536
MemoryMax=12G

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/coins/data/bcash/blockbook
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
