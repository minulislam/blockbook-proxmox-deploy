[Unit]
Description=Blockbook Zcash indexer and API
After=backend-zcash.service network.target
Wants=backend-zcash.service

[Service]
Type=simple
User=blockbook-zcash
Group=blockbook-zcash
ExecStart=/opt/coins/blockbook/zcash/bin/blockbook \
    -sync \
    -blockchaincfg=/opt/coins/blockbook/zcash/blockchaincfg.json \
    -internal=:9034 \
    -public=:9134 \
    -certfile=/opt/coins/blockbook/zcash/server/testcert \
    -dbcache=500 \
    -workers=4 \
    -logtostderr
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=30
TimeoutStartSec=600

LimitNOFILE=65536
MemoryMax=12G

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/coins/data/zcash/blockbook
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
