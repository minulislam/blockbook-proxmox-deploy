[Unit]
Description=Bitcoin Core daemon
After=network.target

[Service]
Type=forking
User=bitcoin
Group=bitcoin
ExecStart=/opt/coins/nodes/bitcoin/bin/bitcoind \
    -datadir=/opt/coins/data/bitcoin/backend \
    -conf=/opt/coins/nodes/bitcoin/bitcoin.conf \
    -pid=/opt/coins/data/bitcoin/backend/bitcoind.pid \
    -daemon
ExecStop=/opt/coins/nodes/bitcoin/bin/bitcoin-cli \
    -datadir=/opt/coins/data/bitcoin/backend \
    -conf=/opt/coins/nodes/bitcoin/bitcoin.conf stop
PIDFile=/opt/coins/data/bitcoin/backend/bitcoind.pid
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=300

# Resource limits
LimitNOFILE=65536
MemoryMax=16G

# Hardening
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/coins/data/bitcoin/backend
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
